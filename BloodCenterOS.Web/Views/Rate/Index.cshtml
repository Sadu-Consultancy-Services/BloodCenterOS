@model List<RateMaster>
@{ ViewBag.Title = "Rate Management"; ViewBag.ActiveMenu = "Rates"; }
<div class="page-header">
  <div><h1 class="page-title">Rate Management <small>Per blood group × component pricing</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Rate</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }

<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Blood Group</th><th>Component</th><th>Unit Rate</th><th>Reservation Rate</th><th>Status</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">No rates configured. <a href="@Url.Action("Create")">Add one</a>.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td><span class="badge bg-danger">@item.BloodGroup</span></td>
            <td>@item.ComponentType</td>
            <td>@item.UnitRate.ToString("N2")</td>
            <td>@item.ReservationRate.ToString("N2")</td>
            <td>@if (item.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
            <td class="text-end">
              <form method="post" action="@Url.Action("Delete", new { id = item.RateId })" style="display:inline" onsubmit="return confirm('Deactivate this rate?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
