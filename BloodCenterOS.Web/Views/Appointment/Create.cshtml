@model DonorAppointment
@{ ViewBag.Title = "New Appointment"; ViewBag.ActiveMenu = "Appointments"; }
<div class="page-header">
  <div><h1 class="page-title">New Appointment <small>Schedule a donor appointment</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Appointment Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Donor ID <span class="text-danger">*</span></label><input type="number" name="DonorId" class="form-control" value="@Model.DonorId" required /></div>
        <div class="col-md-4"><label class="form-label">Date <span class="text-danger">*</span></label><input type="date" name="AppointmentDate" class="form-control" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" required /></div>
        <div class="col-md-4"><label class="form-label">Slot <span class="text-danger">*</span></label><input type="text" name="Slot" class="form-control" value="@Model.Slot" placeholder="e.g., 10:00-11:00" required /></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
  </div>
</form>
