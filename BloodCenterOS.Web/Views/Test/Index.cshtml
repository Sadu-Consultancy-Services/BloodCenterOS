@model TestListViewModel
@{
  ViewBag.Title = "Blood Testing";
  ViewBag.ActiveMenu = "Testing";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Blood Testing <small>TTHI screening &amp; results</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Test</a>
  </div>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-check-circle-fill"></i><span>@s</span><button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-exclamation-triangle-fill"></i><span>@e</span><button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button></div> }

<div class="card mb-3">
  <div class="card-header">
    <h6><i class="bi bi-hourglass-split me-1"></i> Pending Tests (@Model.PendingTests.Count)</h6>
  </div>
  <div class="card-body p-0">
    @if (Model.PendingTests.Any())
    {
      <div class="table-container">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Record ID</th>
              <th>Bag Number</th>
              <th>Status</th>
              <th>Created</th>
              <th style="width:100px">Actions</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var t in Model.PendingTests)
            {
              <tr>
                <td>#@t.TestRecordId</td>
                <td><span class="badge badge-secondary">@t.BagNumber</span></td>
                <td><span class="badge @t.StatusBadge">@t.OverallStatus</span></td>
                <td style="font-size:11px">@t.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                <td><a href="@Url.Action("ResultEntry",new{id=t.TestRecordId})" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Enter Results</a></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
    else
    {
      <div class="empty-state py-3"><div class="empty-icon"><i class="bi bi-check-circle" style="color:var(--bc-success)"></i></div><div class="empty-title">No pending tests</div></div>
    }
  </div>
</div>

<div class="card">
  <div class="card-header"><h6><i class="bi bi-check-circle me-1"></i> Completed Tests (@Model.CompletedTests.Count)</h6></div>
  <div class="card-body p-0">
    @if (Model.CompletedTests.Any())
    {
      <div class="table-container">
        <table class="table mb-0">
          <thead><tr><th>ID</th><th>Bag</th><th>Status</th><th>Created</th><th style="width:60px">Actions</th></tr></thead>
          <tbody>
            @foreach (var t in Model.CompletedTests)
            {
              <tr>
                <td>#@t.TestRecordId</td>
                <td><span class="badge badge-secondary">@t.BagNumber</span></td>
                <td><span class="badge @t.StatusBadge">@t.OverallStatus</span></td>
                <td style="font-size:11px">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                <td><a href="@Url.Action("ResultEntry",new{id=t.TestRecordId})" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
    else { <div class="empty-state py-3"><div class="empty-title">No completed tests</div></div> }
  </div>
</div>
