@model BloodTestRecord
@{
  ViewBag.Title = "New Test Record";
  ViewBag.ActiveMenu = "Testing";
}

<div class="page-header">
  <div>
    <h1 class="page-title">New Test Record <small>Register a blood sample for TTHI screening</small></h1>
  </div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
  <div class="alert alert-danger d-flex flex-column gap-1 mb-3 py-2 px-3">
    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div class="d-flex align-items-center gap-2"><i class="bi bi-exclamation-circle"></i><span>@err.ErrorMessage</span></div> }
  </div>
}

<form method="post" action="@Url.Action("Create")">
  <div class="card mb-3">
    <div class="card-header"><h6>Test Record</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label">Bag Number <span class="text-danger">*</span></label>
          <input type="text" name="BagNumber" class="form-control" value="@Model.BagNumber" placeholder="e.g., BAG-2026-0001" required />
        </div>
        <div class="col-md-3">
          <label class="form-label">Collection ID</label>
          <input type="number" name="CollectionId" class="form-control" value="@Model.CollectionId" />
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Test Record</button>
  </div>
</form>
