@model List<ReturnRecord>
@{ ViewBag.Title = "Returns"; ViewBag.ActiveMenu = "Returns"; }
<div class="page-header">
  <div><h1 class="page-title">Returns <small>Component returns</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> New Return</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Issue Record</th><th>Component Code</th><th>Component Type</th><th>Patient Name</th><th>Return Date</th><th>Reason</th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">No returns found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.IssueRecordId</td>
            <td>@item.ComponentId</td>
            <td>—</td>
            <td>—</td>
            <td>@item.ReturnDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Reason</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
