@model BloodCenterOS.Core.Models.ComponentType
@{ ViewBag.Title = "Add Component Type"; ViewBag.ActiveMenu = "ComponentTypes"; }
<div class="page-header">
  <div><h1 class="page-title">Add Component Type <small>Define a blood component type</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Component Type Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Code <span class="text-danger">*</span></label><input type="text" name="ComponentTypeCode" class="form-control" value="@Model.ComponentTypeCode" required placeholder="e.g. PRBC" /></div>
        <div class="col-md-12"><label class="form-label">Description</label><textarea name="Description" class="form-control" rows="3">@Model.Description</textarea></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
  </div>
</form>
