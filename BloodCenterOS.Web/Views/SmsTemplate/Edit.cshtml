@model SmsTemplate
@{ ViewBag.Title = "Edit SMS Template"; ViewBag.ActiveMenu = "SmsTemplates"; }
<div class="page-header">
  <div><h1 class="page-title">Edit SMS Template <small>Update SMS template</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post" action="@Url.Action("Edit", new { id = Model.SmsTemplateId })">
  <div class="card mb-3">
    <div class="card-header"><h6>Template Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Template Code <span class="text-danger">*</span></label><input type="text" name="TemplateCode" class="form-control" value="@Model.TemplateCode" required /></div>
        <div class="col-12"><label class="form-label">Template Text <span class="text-danger">*</span></label><textarea name="TemplateText" class="form-control" rows="4" required>@Model.TemplateText</textarea></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
  </div>
</form>
