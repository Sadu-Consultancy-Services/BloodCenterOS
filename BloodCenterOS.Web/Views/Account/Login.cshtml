<div class="login-page">
  <div class="card login-card">
    <div class="login-logo">
      <img src="~/assets/images/logo.png" alt="BloodCenterOS" style="width:56px;height:56px;margin-bottom:8px" />
      <h4>BloodCenterOS</h4>
      <p>Blood Center Management System</p>
    </div>
    @if (ViewBag.Error != null)
    {
      <div class="alert alert-danger mb-3">@ViewBag.Error</div>
    }
    <form method="post" action="@Url.Action("Login","Account")">
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" placeholder="Enter username" required autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter password" required />
      </div>
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="remember" />
          <label class="form-check-label" for="remember" style="font-size:12px">Remember me</label>
        </div>
        <a href="@Url.Action("ForgotPassword","Account")" style="font-size:12px">Forgot password?</a>
      </div>
      <button type="submit" class="btn btn-primary">Sign In</button>
    </form>
    <p class="text-center mt-3" style="font-size:11px;color:var(--bc-text-muted)">
      BloodCenterOS v1.0 &mdash; Open Source
    </p>
    <p class="text-center" style="font-size:10px;color:var(--bc-text-muted);line-height:1.5;margin-top:8px;border-top:1px solid var(--bc-border);padding-top:8px">
      Developed &amp; Maintained by<br>
      <strong>Sadu Consultancy Services</strong><br>
      Pune, Maharashtra, India<br>
      <a href="https://www.bloodcenteros.com" target="_blank" style="color:var(--bc-primary)">www.bloodcenteros.com</a>
    </p>
  </div>
</div>
