@model List<Expense>
@{ ViewBag.Title = "Expenses"; ViewBag.ActiveMenu = "Expenses"; }
<div class="page-header">
  <div><h1 class="page-title">Expenses <small>Track costs</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Expense</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<form method="get" class="row g-2 mb-3">
  <div class="col-auto"><input type="date" name="from" class="form-control form-control-sm" placeholder="From" value="@Context.Request.Query["from"]" /></div>
  <div class="col-auto"><input type="date" name="to" class="form-control form-control-sm" placeholder="To" value="@Context.Request.Query["to"]" /></div>
  <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Filter</button></div>
</form>
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Date</th><th>Category</th><th>Amount</th><th>Notes</th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">No expenses found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.ExpenseDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Category</td>
            <td>@item.Amount.ToString("N2")</td>
            <td>@item.Notes</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
