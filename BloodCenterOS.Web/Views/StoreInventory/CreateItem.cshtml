@model InvItem

@{
    ViewData["Title"] = "New Store Item";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">New Store Item</h1>

    <form asp-action="CreateItem" method="post">
        <div class="card mb-3">
            <div class="card-header">Item Details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Item Name *</label><input asp-for="ItemName" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-label">Unit</label><input asp-for="ItemUnit" class="form-control" placeholder="Pcs, Box, Ltr..." /></div>
                    <div class="col-md-3"><label class="form-label">Min Order Qty</label><input asp-for="MinOrderQty" class="form-control" type="number" value="0" /></div>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
