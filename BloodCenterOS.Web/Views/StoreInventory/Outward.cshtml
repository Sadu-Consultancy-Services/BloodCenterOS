@model OutwardRequest

@{
    ViewData["Title"] = "Stock Outward";
    var items = ViewBag.Items as List<InvItem> ?? new();
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Stock Outward</h1>

    <form asp-action="Outward" method="post">
        <div class="card mb-3">
            <div class="card-header">Issue Stock</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Item *</label>
                        <select name="ItemId" class="form-select" required>
                            <option value="">Select item</option>
                            @foreach (var item in items)
                            {
                                <option value="@item.ItemId">@item.ItemName (@item.ItemUnit)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Quantity *</label>
                        <input name="Quantity" class="form-control" type="number" min="1" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Description</label>
                        <input name="Description" class="form-control" placeholder="e.g. Issued to lab, department..." />
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-warning">Issue Stock</button>
        </div>
    </form>
</div>
