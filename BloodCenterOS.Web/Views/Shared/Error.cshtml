@model ErrorViewModel
@{
  ViewBag.Title = "Error";
}
<div class="error-page">
  <div>
    <div class="error-code">500</div>
    <div class="error-title">Internal Server Error</div>
    <p class="error-text">An unexpected error occurred. Please try again later or contact support.</p>
    @if (Model.ShowRequestId)
    {
      <p style="font-size:11px;color:var(--bc-text-muted)">Request ID: @Model.RequestId</p>
    }
    <a href="@Url.Action("Index","Home")" class="btn btn-primary"><i class="bi bi-house"></i> Back to Dashboard</a>
  </div>
</div>
