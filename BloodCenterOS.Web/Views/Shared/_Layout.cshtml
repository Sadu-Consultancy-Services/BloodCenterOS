<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — BloodCenterOS</title>
  <link rel="icon" type="image/png" href="~/assets/images/logo.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/assets/css/bloodcenter.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  @if (ViewData["HideLayout"] is true)
  {
    @RenderBody()
  }
  else
  {
    <div class="wrapper">
      <div id="sidebar-overlay" class="sidebar-overlay"></div>
      <partial name="_Sidebar" />
      <div class="main-content">
        <partial name="_Header" />
        <div class="page-content">
          @RenderBody()
        </div>
        <partial name="_Footer" />
      </div>
    </div>
    <partial name="_MobileNav" />
  }

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/assets/js/bloodcenter.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
