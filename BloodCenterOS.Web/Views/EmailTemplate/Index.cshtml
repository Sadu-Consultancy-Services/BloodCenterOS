@model List<EmailTemplate>
@{ ViewBag.Title = "Email Templates"; ViewBag.ActiveMenu = "EmailTemplates"; }
<div class="page-header">
  <div><h1 class="page-title">Email Templates <small>Manage email message templates</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Template</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Code</th><th>Subject</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">No templates.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.TemplateCode</td>
            <td>@item.Subject</td>
            <td class="text-end">
              <a href="@Url.Action("Edit", new { id = item.EmailTemplateId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form method="post" action="@Url.Action("Delete", new { id = item.EmailTemplateId })" style="display:inline" onsubmit="return confirm('Delete this template?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
