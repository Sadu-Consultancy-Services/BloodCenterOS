@model List<Employee>
@{
  ViewBag.Title = "Employees";
  ViewBag.ActiveMenu = "Employees";
}
<div class="page-header">
  <div><h1 class="page-title">Employees <small>Manage employees</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Employee</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Designation</th><th>Department</th><th>Status</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-3">No employees found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.EmployeeCode</td>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.Designation</td>
            <td>@item.DepartmentName</td>
            <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
            <td class="text-end">
              <a href="@Url.Action("Edit", new { id = item.EmployeeId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form method="post" action="@Url.Action("ToggleActive", new { id = item.EmployeeId })" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-@(item.IsActive ? "pause" : "play")"></i></button>
              </form>
              <form method="post" action="@Url.Action("Delete", new { id = item.EmployeeId })" style="display:inline" onsubmit="return confirm('Delete this employee?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
