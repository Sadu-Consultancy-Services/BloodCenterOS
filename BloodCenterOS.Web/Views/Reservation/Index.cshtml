@model List<PatientReservation>
@{ ViewBag.Title = "Patient Reservations"; ViewBag.ActiveMenu = "Reservations"; }
<div class="page-header">
  <div><h1 class="page-title">Patient Reservations <small>FIFO blood allocation</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> New Reservation</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }

<form method="get" class="row g-2 mb-3">
  <div class="col-md-2">
    <label class="form-label-sm text-muted mb-0">Status</label>
    <select name="status" class="form-select form-select-sm">
      <option value="">All</option>
      <option value="Active" selected="@(ViewBag.SelectedStatus == "Active")">Active</option>
      <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Cancelled</option>
      <option value="Issued" selected="@(ViewBag.SelectedStatus == "Issued")">Issued</option>
    </select>
  </div>
  <div class="col-md-2">
    <label class="form-label-sm text-muted mb-0">From</label>
    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
  </div>
  <div class="col-md-2">
    <label class="form-label-sm text-muted mb-0">To</label>
    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
  </div>
  <div class="col-md-3">
    <label class="form-label-sm text-muted mb-0">Search</label>
    <input type="text" name="keyword" class="form-control form-control-sm" placeholder="Patient / Hospital" value="@ViewBag.Keyword" />
  </div>
  <div class="col-md-3 d-flex align-items-end gap-1">
    <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">Clear</a>
  </div>
</form>

<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Date</th><th>Patient</th><th>BG (Pat)</th><th>BG (Req)</th><th>Hospital</th><th>Component</th><th>Units</th><th>Status</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-3">No reservations found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.ReservationDate.ToString("dd/MM")</td>
            <td>@item.PatientName</td>
            <td><span class="badge bg-secondary">@item.PatientBloodGroup</span></td>
            <td><span class="badge bg-danger">@item.RequiredBloodGroup</span></td>
            <td>@item.HospitalName</td>
            <td>@item.ComponentType</td>
            <td>@item.UnitsReserved/@item.UnitsRequested</td>
            <td>
              @if (item.Status == "Active") { <span class="badge bg-success">Active</span> }
              else if (item.Status == "Cancelled") { <span class="badge bg-secondary">Cancelled</span> }
              else if (item.Status == "Issued") { <span class="badge bg-info">Issued</span> }
            </td>
            <td class="text-end">
              <a href="@Url.Action("Details", new { id = item.ReservationId })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
              @if (item.Status == "Active")
              {
                <form method="post" action="@Url.Action("Cancel", new { id = item.ReservationId })" style="display:inline" onsubmit="return confirm('Cancel this reservation? Components will be released.')">
                  <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-x-circle"></i></button>
                </form>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
