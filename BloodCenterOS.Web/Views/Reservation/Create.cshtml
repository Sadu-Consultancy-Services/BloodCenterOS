@model ReservationCreateRequest
@{ ViewBag.Title = "Create Reservation"; ViewBag.ActiveMenu = "Reservations"; }
<div class="page-header">
  <div><h1 class="page-title">Create Patient Reservation</h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 px-3 mb-3">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        { <div>@err.ErrorMessage</div> }
    </div>
}

<form method="post">
    <div class="card mb-3">
        <div class="card-header"><strong>Patient Details</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Patient Name *</label>
                    <input type="text" name="PatientName" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Contact No</label>
                    <input type="text" name="PatientContactNo" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Patient Blood Group *</label>
                    <select name="PatientBloodGroup" class="form-select" required>
                        <option value="">--</option>
                        <option value="A+">A+</option><option value="A-">A-</option>
                        <option value="B+">B+</option><option value="B-">B-</option>
                        <option value="AB+">AB+</option><option value="AB-">AB-</option>
                        <option value="O+">O+</option><option value="O-">O-</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Address</label>
                    <input type="text" name="PatientAddress" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>Blood Requirement</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Required Blood Group *</label>
                    <select name="RequiredBloodGroup" class="form-select" required>
                        <option value="">--</option>
                        <option value="A+">A+</option><option value="A-">A-</option>
                        <option value="B+">B+</option><option value="B-">B-</option>
                        <option value="AB+">AB+</option><option value="AB-">AB-</option>
                        <option value="O+">O+</option><option value="O-">O-</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Component Type *</label>
                    <select name="ComponentType" class="form-select" required>
                        <option value="">--</option>
                        <option value="WB">WB (Whole Blood)</option>
                        <option value="PCV">PCV (Packed Cells)</option>
                        <option value="FFP">FFP (Fresh Frozen Plasma)</option>
                        <option value="PC">PC (Platelet Concentrate)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Units *</label>
                    <input type="number" name="Units" class="form-control" value="1" min="1" max="20" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hospital</label>
                    <input type="text" name="HospitalName" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ward</label>
                    <input type="text" name="Ward" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input type="checkbox" name="CreateInvoice" class="form-check-input" value="true" id="chkInvoice" />
                        <label class="form-check-label" for="chkInvoice">Create invoice for this reservation</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Reserve Blood</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
