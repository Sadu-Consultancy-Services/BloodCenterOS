@{ ViewBag.Title = "Store Component"; ViewBag.ActiveMenu = "ComponentLog"; var componentId = ViewBag.ComponentId as long?; }
<div class="page-header">
  <div><h1 class="page-title">Store Component <small>Place component in fridge</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Storage Details</h6></div>
    <div class="card-body">
      <input type="hidden" name="componentId" value="@componentId" />
      <div class="row g-2">
        <div class="col-md-4">
          <label class="form-label">Fridge ID <span class="text-danger">*</span></label>
          <input type="number" name="fridgeId" class="form-control" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" placeholder="e.g. Shelf A-3" />
        </div>
        <div class="col-md-12">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-control" rows="3"></textarea>
        </div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-success"><i class="bi bi-archive"></i> Store</button>
  </div>
</form>
