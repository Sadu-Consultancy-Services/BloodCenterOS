@{ ViewBag.Title = "Transfer Component"; ViewBag.ActiveMenu = "ComponentLog"; var componentId = ViewBag.ComponentId as long?; }
<div class="page-header">
  <div><h1 class="page-title">Transfer Component <small>Send component to another center</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Transfer Details</h6></div>
    <div class="card-body">
      <input type="hidden" name="componentId" value="@componentId" />
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label">Destination Center ID <span class="text-danger">*</span></label>
          <input type="number" name="toCenterId" class="form-control" required />
        </div>
        <div class="col-md-12">
          <label class="form-label">Transport Details</label>
          <input type="text" name="transportDetails" class="form-control" placeholder="e.g. Courier name, vehicle no, temperature logs" />
        </div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-left-right"></i> Transfer</button>
  </div>
</form>
