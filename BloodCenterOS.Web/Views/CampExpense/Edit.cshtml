@model CampExpense
@{ ViewBag.Title = "Edit Camp Expense"; ViewBag.ActiveMenu = "CampExpenses"; }
<div class="page-header">
  <div><h1 class="page-title">Edit Camp Expense <small>Update expense details</small></h1></div>
  <a href="@Url.Action("Index", new { campId = Model.CampId })" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post" action="@Url.Action("Edit", new { id = Model.CampExpenseId })">
  <div class="card mb-3">
    <div class="card-header"><h6>Expense Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Category <span class="text-danger">*</span></label><input type="text" name="ExpenseCategory" class="form-control" value="@Model.ExpenseCategory" required /></div>
        <div class="col-md-6"><label class="form-label">Amount</label><input type="number" step="0.01" name="Amount" class="form-control" value="@Model.Amount" /></div>
        <div class="col-12"><label class="form-label">Notes</label><textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index", new { campId = Model.CampId })" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
  </div>
</form>
