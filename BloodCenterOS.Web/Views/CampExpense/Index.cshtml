@model List<CampExpense>
@{ ViewBag.Title = "Camp Expenses"; ViewBag.ActiveMenu = "CampExpenses"; }
<div class="page-header">
  <div><h1 class="page-title">Camp Expenses <small>Track camp-related expenditure</small></h1></div>
  <a href="@Url.Action("Create", new { campId = ViewBag.CampId })" class="btn btn-primary"><i class="bi bi-plus"></i> Add Expense</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Camp</th><th>Category</th><th>Amount</th><th>Notes</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">No expenses found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.CampName</td><td>@item.ExpenseCategory</td>
            <td>@(item.Amount?.ToString("0.00") ?? "-")</td><td>@(item.Notes ?? "-")</td>
            <td class="text-end">
              <a href="@Url.Action("Edit", new { id = item.CampExpenseId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form method="post" action="@Url.Action("Delete", new { id = item.CampExpenseId, campId = ViewBag.CampId })" style="display:inline" onsubmit="return confirm('Delete this expense?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
