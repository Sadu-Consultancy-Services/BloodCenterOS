@{
  ViewBag.Title = "UI Components";
  ViewBag.ActiveMenu = "Dashboard";
}

<div class="page-header">
  <h1 class="page-title">UI Components <small>Design system showcase</small></h1>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card mb-3">
      <div class="card-header"><h6>Buttons</h6></div>
      <div class="card-body d-flex flex-wrap gap-2">
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-success">Success</button>
        <button class="btn btn-warning">Warning</button>
        <button class="btn btn-danger">Danger</button>
        <button class="btn btn-info">Info</button>
        <button class="btn btn-outline-primary">Outline</button>
        <button class="btn btn-sm btn-primary">Small</button>
        <button class="btn btn-lg btn-primary">Large</button>
        <button class="btn btn-soft-primary">Soft</button>
        <button class="btn btn-primary" disabled>Disabled</button>
        <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> With Icon</button>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><h6>Alerts</h6></div>
      <div class="card-body d-flex flex-column gap-2">
        <div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Danger alert message</div>
        <div class="alert alert-success mb-0"><i class="bi bi-check-circle-fill"></i> Success alert message</div>
        <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-circle-fill"></i> Warning alert message</div>
        <div class="alert alert-info mb-0"><i class="bi bi-info-circle-fill"></i> Info alert message</div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><h6>Badges</h6></div>
      <div class="card-body d-flex flex-wrap gap-2">
        <span class="badge badge-success">Active</span>
        <span class="badge badge-warning">Pending</span>
        <span class="badge badge-danger">Expired</span>
        <span class="badge badge-info">Info</span>
        <span class="badge badge-secondary">Draft</span>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card mb-3">
      <div class="card-header"><h6>Form Controls</h6></div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label">Text Input</label>
            <input type="text" class="form-control" placeholder="Placeholder" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Select</label>
            <select class="form-select"><option>Option 1</option><option>Option 2</option></select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Date Picker</label>
            <input type="date" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Search</label>
            <input type="search" class="form-control" placeholder="Search..." />
          </div>
          <div class="col-12">
            <label class="form-label">Textarea</label>
            <textarea class="form-control" rows="3" placeholder="Enter notes..."></textarea>
          </div>
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" checked />
              <label class="form-check-label">Toggle Switch</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><h6>Progress</h6></div>
      <div class="card-body d-flex flex-column gap-2">
        <div class="progress"><div class="progress-bar" style="width:75%"></div></div>
        <div class="progress" style="height:10px"><div class="progress-bar" style="width:45%"></div></div>
      </div>
    </div>
  </div>
</div>
