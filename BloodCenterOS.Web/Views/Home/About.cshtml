@{
  ViewBag.Title = "About";
  ViewBag.ActiveMenu = "";
}

<div class="page-header">
  <h1 class="page-title">About BloodCenterOS <small>Open Source Blood Center Management System</small></h1>
</div>

<div class="card">
  <div class="card-body" style="padding:2em;max-width:640px;margin:0 auto;text-align:center">
    <img src="~/assets/images/logo.png" alt="BloodCenterOS" style="width:72px;height:72px;margin:0 auto 1em" />
    <h3 style="margin:0 0 .3em">BloodCenterOS v1.0</h3>
    <p style="color:var(--bc-text-muted);margin-bottom:1.5em">Open Source Blood Center Management System</p>

    <div style="border-top:1px solid var(--bc-border);padding-top:1.5em">
      <p style="margin:0 0 .3em;font-size:13px;color:var(--bc-text-muted)">Developed &amp; Maintained by</p>
      <p style="margin:0 0 .2em;font-size:15px;font-weight:600">Sadu Consultancy Services</p>
      <p style="margin:0 0 1em;font-size:13px;color:var(--bc-text-muted)">Pune, Maharashtra, India</p>
      <p style="margin:0"><a href="https://www.bloodcenteros.com" target="_blank" style="color:var(--bc-primary)">www.bloodcenteros.com</a></p>
    </div>

    <div style="border-top:1px solid var(--bc-border);padding-top:1.5em;margin-top:1.5em;font-size:12px;color:var(--bc-text-muted)">
      <p style="margin:0">This software is released under the MIT License.</p>
      <p style="margin:.5em 0 0">Designed with Indian blood center workflows in mind — review NBTC/NACO guidelines for regulatory compliance.</p>
    </div>
  </div>
</div>
