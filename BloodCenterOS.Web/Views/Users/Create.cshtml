@{
  ViewBag.Title = "Add User";
  ViewBag.ActiveMenu = "Users";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Add User <small>Create a new system user</small></h1>
  </div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
  <div class="alert alert-danger d-flex flex-column gap-1 mb-3 py-2 px-3">
    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
      <div class="d-flex align-items-center gap-2"><i class="bi bi-exclamation-circle"></i> <span>@err.ErrorMessage</span></div>
    }
  </div>
}

<form method="post" action="@Url.Action("Create")">
  <div class="card mb-3">
    <div class="card-header"><h6>Account Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label">Username <span class="text-danger">*</span></label>
          <input type="text" name="userName" class="form-control" required />
        </div>
        <div class="col-md-6">
          <label class="form-label">Display Name</label>
          <input type="text" name="displayName" class="form-control" />
        </div>
        <div class="col-md-6">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" />
        </div>
        <div class="col-md-6">
          <label class="form-label">Phone</label>
          <input type="tel" name="phone" class="form-control" />
        </div>
        <div class="col-md-6">
          <label class="form-label">Password <span class="text-danger">*</span></label>
          <input type="password" name="password" class="form-control" required />
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save User</button>
  </div>
</form>
