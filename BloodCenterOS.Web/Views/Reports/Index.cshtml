    fetch('/Reports/CrossMatchReportData?invoiceId='+id).then(r=>r.json()).then(d=>{
      if(!d||!d.length){tb.innerHTML='<tr><td colspan="9" class="text-center text-muted">No data.</td></tr>';return;}
      tb.innerHTML=d.map(r=>'<tr><td>'+r.invoiceId+'</td><td>'+r.patientName+'</td><td>'+(r.patientBloodGroup||'')+'</td><td>'+(r.hospitalName||'')+'</td><td>'+(r.componentType||'')+'</td><td>'+(r.bloodGroup||'')+'</td><td>'+(r.overallResult||'')+'</td><td>'+(r.testType||'')+'</td><td>'+(r.testResult||'')+'</td></tr>').join('');
    }).catch(()=>{tb.innerHTML='<tr><td colspan="9" class="text-center text-danger">Failed.</td></tr>';});
  }

  // Auto-load donor report on page load
  document.addEventListener('DOMContentLoaded', function() { loadDonorReport(); });
</script>
}
