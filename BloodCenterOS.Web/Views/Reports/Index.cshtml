@{
  ViewBag.Title = "Reports";
  ViewBag.ActiveMenu = "Reports";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Reports Dashboard</h1>
  </div>
</div>

<div class="mb-2">
  <select id="reportSelector" class="form-select form-select-sm" style="max-width:400px" onchange="switchReport(this.value)">
    <optgroup label="Summary Reports">
      <option value="tab-donor" selected>Donor Summary</option>
      <option value="tab-camp">Camp Summary</option>
      <option value="tab-procurement">Procurement Summary</option>
      <option value="tab-blood-stock">Blood Stock</option>
      <option value="tab-inventory">Inventory Summary</option>
      <option value="tab-inv-stock">Store Inventory Stock</option>
    </optgroup>
    <optgroup label="Financial Reports">
      <option value="tab-cm-income">Cross Match Income</option>
      <option value="tab-discount">Discount Details</option>
      <option value="tab-daily-issues">Daily Issues</option>
      <option value="tab-dues">Dues Register</option>
      <option value="tab-mbb-inward">MBB Inward</option>
    </optgroup>
    <optgroup label="Operational Reports">
      <option value="tab-donor-list">Donor List</option>
      <option value="tab-qc-daily">QC Daily</option>
      <option value="tab-discard">Discard Register</option>
      <option value="tab-autoclave">Autoclave Register</option>
      <option value="tab-inv-inout">Store Inventory In/Out</option>
    </optgroup>
    <optgroup label="Invoice Reports">
      <option value="tab-invoice-detail">Invoice Detail</option>
      <option value="tab-bs-invoice">BS Invoice Detail</option>
      <option value="tab-crossmatch">Cross Match Report</option>
    </optgroup>
  </select>
</div>

<div class="tab-content" id="reportTabContent">

  @* ── Donor Summary ── *@
  <div class="tab-pane fade show active" id="tab-donor">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="donorFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="donorTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDonorReport()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Donor Summary</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Period</th><th>Registered</th><th>A+</th><th>A-</th><th>B+</th><th>B-</th><th>AB+</th><th>AB-</th><th>O+</th><th>O-</th><th>Deferrals</th><th>Collections</th></tr></thead>
          <tbody id="donorTableBody"><tr><td colspan="12" class="text-center text-muted" style="padding:2em">Select date range and click Load.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Camp Summary ── *@
  <div class="tab-pane fade" id="tab-camp">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="campFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="campTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadCampReport()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Camp Summary</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Period</th><th>Camps</th><th>Expected</th><th>Collected</th><th>Rate (%)</th></tr></thead>
          <tbody id="campTableBody"><tr><td colspan="5" class="text-center text-muted" style="padding:2em">Select date range and click Load.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Inventory Summary (blood components) ── *@
  <div class="tab-pane fade" id="tab-inventory">
    <div class="card mb-3"><div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <span style="font-size:13px">Current blood component stock levels</span>
        <button class="btn btn-primary btn-sm" onclick="loadInventoryReport()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Blood Inventory Summary</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Component</th><th>Blood Group</th><th>Available</th><th>Reserved</th><th>Quarantined</th><th>Near Expiry</th></tr></thead>
          <tbody id="invTableBody"><tr><td colspan="6" class="text-center text-muted" style="padding:2em">Click Refresh to load.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ═══════════════════════════════════════════════════════════════ *@
  @* Phase 9: New Reports                                           *@
  @* ═══════════════════════════════════════════════════════════════ *@

  @* ── Blood Stock ── *@
  <div class="tab-pane fade" id="tab-blood-stock">
    <div class="card mb-3"><div class="card-body">
      <span style="font-size:13px">Current available blood stock by group and component</span>
      <button class="btn btn-primary btn-sm float-end" onclick="loadBloodStock()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div></div>
    <div class="card"><div class="card-header"><h6>Blood Stock</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Blood Group</th><th>Component</th><th>Available Qty</th><th>Earliest Expiry</th></tr></thead>
          <tbody id="bloodStockBody"><tr><td colspan="4" class="text-center text-muted" style="padding:2em">Click Refresh.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Procurement Summary ── *@
  <div class="tab-pane fade" id="tab-procurement">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="procFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="procTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadProcurementSummary()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Procurement Summary (8x4 Matrix)</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0 table-bordered" style="font-size:11px">
          <thead><tr><th>Blood Group</th><th>WB Avail</th><th>WB Issued</th><th>WB Disc</th><th>PCV Avail</th><th>PCV Issued</th><th>PCV Disc</th><th>FFP Avail</th><th>FFP Issued</th><th>FFP Disc</th><th>PC Avail</th><th>PC Issued</th><th>PC Disc</th><th>Total Avail</th><th>Total Issued</th><th>Total Disc</th></tr></thead>
          <tbody id="procSummaryBody"><tr><td colspan="16" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Store Inventory Stock ── *@
  <div class="tab-pane fade" id="tab-inv-stock">
    <div class="card mb-3"><div class="card-body">
      <span style="font-size:13px">Current general store inventory stock</span>
      <button class="btn btn-primary btn-sm float-end" onclick="loadInvStock()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div></div>
    <div class="card"><div class="card-header"><h6>Store Inventory Stock</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Item</th><th>Unit</th><th>Min Order</th><th>Current Stock</th><th>Last Txn Date</th></tr></thead>
          <tbody id="invStockBody"><tr><td colspan="5" class="text-center text-muted" style="padding:2em">Click Refresh.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── CM Income ── *@
  <div class="tab-pane fade" id="tab-cm-income">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="cmFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="cmTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadCmIncome()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Cross Match Income</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Date</th><th>Invoice #</th><th>Patient</th><th>Total Amt</th><th>Emergency</th><th>Discount</th></tr></thead>
          <tbody id="cmIncomeBody"><tr><td colspan="6" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Discount Details ── *@
  <div class="tab-pane fade" id="tab-discount">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="discFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="discTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDiscountDetails()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Discount Details</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Date</th><th>Invoice #</th><th>Patient</th><th>Gross</th><th>Discount</th><th>Net</th><th>Reason</th><th>Status</th></tr></thead>
          <tbody id="discountBody"><tr><td colspan="8" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Daily Issues ── *@
  <div class="tab-pane fade" id="tab-daily-issues">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="issFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="issTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDailyIssues()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Daily Issues</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Date</th><th>Invoice #</th><th>Patient</th><th>Component</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead>
          <tbody id="dailyIssuesBody"><tr><td colspan="7" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Dues Register ── *@
  <div class="tab-pane fade" id="tab-dues">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">As On Date</label><input type="date" id="duesDate" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDuesRegister()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Dues Register</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Date</th><th>Invoice #</th><th>Patient</th><th>Total</th><th>Paid</th><th>Due</th><th>Status</th><th>Days Overdue</th></tr></thead>
          <tbody id="duesBody"><tr><td colspan="8" class="text-center text-muted" style="padding:2em">Click Load.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── MBB Inward ── *@
  <div class="tab-pane fade" id="tab-mbb-inward">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="mbbFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="mbbTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">Supplier</label><input type="text" id="mbbSupplier" class="form-control form-control-sm" placeholder="Filter..." /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadMbbInward()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>MBB Inward</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Bill #</th><th>Date</th><th>Supplier</th><th>Component</th><th>BG</th><th>Qty</th><th>Unit Price</th><th>Line Total</th><th>Total</th><th>Status</th></tr></thead>
          <tbody id="mbbInwardBody"><tr><td colspan="10" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Donor List ── *@
  <div class="tab-pane fade" id="tab-donor-list">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="dlFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="dlTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><label class="form-check-label"><input type="checkbox" id="dlContact" checked /> Show Contact</label></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDonorList()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Donor List</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>#</th><th>Name</th><th>Gender</th><th>Blood Group</th><th>Phone</th><th>Email</th><th>Last Donation</th><th>Total</th></tr></thead>
          <tbody id="donorListBody"><tr><td colspan="8" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── QC Daily ── *@
  <div class="tab-pane fade" id="tab-qc-daily">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">Date</label><input type="date" id="qcDate" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadQcDaily()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>QC Daily Report</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>Type</th><th>Unit No</th><th>Specificity</th><th>Batch</th><th>Expiry</th><th>Reactivity</th><th>Activity</th><th>Titre</th><th>Appearance</th><th>Haemolysis</th><th>Sp.Gravity</th><th>High Ctrl</th><th>Low Ctrl</th></tr></thead>
          <tbody id="qcDailyBody"><tr><td colspan="13" class="text-center text-muted" style="padding:2em">Select date.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Discard Register ── *@
  <div class="tab-pane fade" id="tab-discard">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="discardFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="discardTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">Reason</label><input type="text" id="discardReason" class="form-control form-control-sm" placeholder="Filter..." /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadDiscardRegister()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Discard Register</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>#</th><th>Component</th><th>Type</th><th>Donor</th><th>BG</th><th>Reason</th><th>Date</th><th>Bag</th><th>AutoClave Start</th><th>AutoClave End</th></tr></thead>
          <tbody id="discardBody"><tr><td colspan="10" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Autoclave Register ── *@
  <div class="tab-pane fade" id="tab-autoclave">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="acFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="acTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadAutoclaveRegister()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Autoclave Register</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>#</th><th>Component</th><th>Donor</th><th>BG</th><th>Reason</th><th>Start</th><th>End</th></tr></thead>
          <tbody id="autoclaveBody"><tr><td colspan="7" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Store Inventory In/Out ── *@
  <div class="tab-pane fade" id="tab-inv-inout">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">From</label><input type="date" id="ioFrom" class="form-control form-control-sm" value="@ViewBag.FromDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">To</label><input type="date" id="ioTo" class="form-control form-control-sm" value="@ViewBag.ToDate" /></div>
        <div class="col-auto"><label class="form-label" style="font-size:11px">Type</label><select id="ioType" class="form-select form-select-sm"><option value="">All</option><option value="I">Inward</option><option value="O">Outward</option></select></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadInvInOut()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Store Inventory Transactions</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
        <table class="table mb-0" style="font-size:12px">
          <thead><tr><th>#</th><th>Item</th><th>Qty</th><th>Type</th><th>Date</th><th>Description</th></tr></thead>
          <tbody id="invInOutBody"><tr><td colspan="6" class="text-center text-muted" style="padding:2em">Select date range.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  @* ── Invoice Detail ── *@
  <div class="tab-pane fade" id="tab-invoice-detail">
    <div class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-auto"><label class="form-label" style="font-size:11px">Invoice ID</label><input type="number" id="invId" class="form-control form-control-sm" min="1" /></div>
        <div class="col-auto"><button class="btn btn-primary btn-sm" onclick="loadInvoiceDetail()"><i class="bi bi-search"></i> Load</button></div>
      </div>
    </div></div>
    <div class="card"><div class="card-header"><h6>Invoice Detail</h6></div>
      <div class="card-body p-0" style="overflow-x:auto">
