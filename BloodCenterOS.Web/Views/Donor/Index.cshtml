@model DonorSearchViewModel
@{
  ViewBag.Title = "Donor Management";
  ViewBag.ActiveMenu = "Donors";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Donor Management <small>Manage blood donor records</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Donor</a>
    <button class="btn btn-outline-secondary"><i class="bi bi-download"></i> Export</button>
  </div>
</div>

@if (TempData["Success"] is string success)
{
  <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3">
    <i class="bi bi-check-circle-fill"></i> <span>@success</span>
    <button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button>
  </div>
}
@if (TempData["Error"] is string error)
{
  <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3">
    <i class="bi bi-exclamation-triangle-fill"></i> <span>@error</span>
    <button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button>
  </div>
}

<form method="get" action="@Url.Action("Index")">
  <div class="card mb-3">
    <div class="filter-bar">
      <i class="bi bi-funnel text-muted" style="font-size:14px"></i>
      <input type="text" name="keyword" class="form-control" placeholder="Search name, code, phone..." style="min-width:200px" value="@Model.Keyword" />
      <select name="bloodGroup" class="form-select" style="min-width:140px">
        <option value="">All Blood Groups</option>
        @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
        {
          <option value="@bg" selected="@(Model.BloodGroup == bg)">@bg</option>
        }
      </select>
      <select name="gender" class="form-select" style="min-width:120px">
        <option value="">All Genders</option>
        <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
        <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
        <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
      </select>
      <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
      <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Clear</a>
    </div>
  </div>
</form>

<div class="card">
  <div class="card-header">
    <h6>@Model.TotalCount records found</h6>
    <div class="d-flex gap-2 align-items-center">
      <span style="font-size:11px;color:var(--bc-text-muted)">Show</span>
      <select class="form-select form-select-sm" style="width:70px">
        <option>20</option><option>50</option><option>100</option>
      </select>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-container">
      <table class="table mb-0">
        <thead>
          <tr>
            <th style="width:36px"><input type="checkbox" class="form-check-input" /></th>
            <th>Code</th>
            <th>Name</th>
            <th>Blood Group</th>
            <th>Phone</th>
            <th>City</th>
            <th>Last Donation</th>
            <th class="text-center">Donations</th>
            <th>Status</th>
            <th style="width:80px">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model.Items)
          {
            <tr>
              <td><input type="checkbox" class="form-check-input" /></td>
              <td><span class="badge badge-secondary">@item.Code</span></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="avatar" style="background:#dc2626">@(item.Name.Split(' ').LastOrDefault()?.FirstOrDefault() ?? '?')</span>
                  <div>
                    <a href="@Url.Action("Details", new { id = item.Id })" style="font-weight:500;font-size:13px;color:var(--bc-text)">@item.Name</a>
                  </div>
                </div>
              </td>
              <td><span class="badge" style="background:#dcfce7;color:#166534">@item.BloodGroup</span></td>
              <td>@item.Phone</td>
              <td>@item.City</td>
              <td style="font-size:11px">@(item.LastDonation?.ToString("dd MMM yyyy") ?? "—")</td>
              <td class="text-center">@item.TotalDonations</td>
              <td>
                <span class="badge @(item.Status == "Active" ? "badge-success" : "badge-warning")">@item.Status</span>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                  <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                  <div class="dropdown" style="position:relative">
                    <button class="btn btn-sm btn-outline-secondary" data-bc-dropdown-toggle data-bc-target="row-action-@item.Id"><i class="bi bi-three-dots-vertical"></i></button>
                    <div class="dropdown-menu" id="row-action-@item.Id" style="position:absolute;right:0;min-width:160px">
                      <a class="dropdown-item" href="@Url.Action("Details", new { id = item.Id })"><i class="bi bi-clock-history"></i> History</a>
                      <a class="dropdown-item" href="#"><i class="bi bi-exclamation-triangle"></i> Defer</a>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item text-danger" href="#"><i class="bi bi-trash"></i> Delete</a>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          }
          @if (!Model.Items.Any())
          {
            <tr>
              <td colspan="10">
                <div class="empty-state">
                  <div class="empty-icon"><i class="bi bi-people"></i></div>
                  <div class="empty-title">No donors found</div>
                  <div class="empty-text">Try adjusting your search filters or add a new donor.</div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer d-flex align-items-center justify-content-between">
    <span style="font-size:11px;color:var(--bc-text-muted)">Showing 1-@Model.Items.Count of @Model.TotalCount</span>
    <nav>
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
          <a class="page-link" href="@Url.Action("Index", new { keyword = Model.Keyword, bloodGroup = Model.BloodGroup, gender = Model.Gender, page = Model.Page - 1 })"><i class="bi bi-chevron-left"></i></a>
        </li>
        @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
        {
          <li class="page-item @(p == Model.Page ? "active" : "")">
            <a class="page-link" href="@Url.Action("Index", new { keyword = Model.Keyword, bloodGroup = Model.BloodGroup, gender = Model.Gender, page = p })">@p</a>
          </li>
        }
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
          <a class="page-link" href="@Url.Action("Index", new { keyword = Model.Keyword, bloodGroup = Model.BloodGroup, gender = Model.Gender, page = Model.Page + 1 })"><i class="bi bi-chevron-right"></i></a>
        </li>
      </ul>
    </nav>
  </div>
</div>
