@model DonorDetailViewModel
@{
  ViewBag.ActiveMenu = "Donors";
  var d = Model.Donor;
}

<div class="page-header">
  <div>
    <h1 class="page-title">@d.FullName <small>@d.DonorCode</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Edit", new { id = d.DonorId })" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
  </div>
</div>

<div class="row g-2 mb-3">
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="stat-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-droplet"></i></div>
      <div>
        <div class="stat-value">@d.BloodGroup</div>
        <div class="stat-label">Blood Group</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="stat-icon" style="background:#dbeafe;color:#0284c7"><i class="bi bi-clock-history"></i></div>
      <div>
        <div class="stat-value">@d.TotalDonations</div>
        <div class="stat-label">Total Donations</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="stat-icon" style="background:#fef9c3;color:#d97706"><i class="bi bi-calendar"></i></div>
      <div>
        <div class="stat-value" style="font-size:16px">@(d.LastDonationDate?.ToString("dd MMM yyyy") ?? "—")</div>
        <div class="stat-label">Last Donation</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="stat-icon" style="background:#fee2e2;color:#dc2626"><i class="bi bi-person-check"></i></div>
      <div>
        <div class="stat-value" style="font-size:16px;color:var(--bc-success)">Active</div>
        <div class="stat-label">Status</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-2 mb-3">
  <div class="col-md-7">
    <div class="card">
      <div class="card-header"><h6>Personal Information</h6></div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Full Name</div>
            <div style="font-size:13px;font-weight:500">@d.FullName</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Gender</div>
            <div style="font-size:13px">@(d.Gender ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Date of Birth</div>
            <div style="font-size:13px">@(d.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Blood Group</div>
            <div style="font-size:13px"><span class="badge" style="background:#dcfce7;color:#166534">@d.BloodGroup</span></div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Occupation</div>
            <div style="font-size:13px">@(d.Occupation ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Preferred Language</div>
            <div style="font-size:13px">@(d.PreferredLanguage ?? "—")</div>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-2">
      <div class="card-header"><h6>Contact Details</h6></div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Phone</div>
            <div style="font-size:13px">@(d.Phone ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Email</div>
            <div style="font-size:13px">@(d.Email ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">Aadhaar Number</div>
            <div style="font-size:13px">@(d.AadhaarNumber ?? "—")</div>
          </div>
          <div class="col-md-6">
            <div style="font-size:11px;color:var(--bc-text-muted)">City</div>
            <div style="font-size:13px">@(d.City ?? "—")</div>
          </div>
          <div class="col-12">
            <div style="font-size:11px;color:var(--bc-text-muted)">Address</div>
            <div style="font-size:13px">@($"{d.AddressLine1}{(!string.IsNullOrEmpty(d.AddressLine2) ? ", " + d.AddressLine2 : "")}{(d.Pincode != null ? " — " + d.Pincode : "")}")</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card">
      <div class="card-header"><h6>Donation History</h6></div>
      <div class="card-body p-0">
        @if (Model.Donations.Any())
        {
          <div class="table-container">
            <table class="table table-compact mb-0">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Volume</th>
                  <th>Bag #</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var don in Model.Donations)
                {
                  <tr>
                    <td style="font-size:11px">@don.DonationDate.ToString("dd MMM yyyy")</td>
                    <td>@(don.DonationType ?? "—")</td>
                    <td>@(don.VolumeMl?.ToString("F0") ?? "—") ml</td>
                    <td style="font-size:11px">@(don.BagNumber ?? "—")</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
        else
        {
          <div class="empty-state py-4">
            <div class="empty-icon" style="font-size:32px"><i class="bi bi-droplet"></i></div>
            <div class="empty-title">No donation history</div>
            <div class="empty-text">This donor has not donated any blood yet.</div>
          </div>
        }
      </div>
    </div>

    <div class="card mt-2">
      <div class="card-header"><h6>Quick Actions</h6></div>
      <div class="card-body">
        <div class="d-flex flex-column gap-2">
          <a href="@Url.Action("Create","Collection")" class="btn btn-outline-secondary w-100 justify-content-start"><i class="bi bi-droplet"></i> New Collection</a>
          <a href="@Url.Action("Create","Test")" class="btn btn-outline-secondary w-100 justify-content-start"><i class="bi bi-eyedropper"></i> New Test</a>
          <a href="@Url.Action("Index","Donor")" class="btn btn-outline-secondary w-100 justify-content-start"><i class="bi bi-clock-history"></i> Donor List</a>
        </div>
      </div>
    </div>
  </div>
</div>
