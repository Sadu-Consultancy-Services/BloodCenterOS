@model CollectionListViewModel
@{
  ViewBag.Title = "Blood Collections";
  ViewBag.ActiveMenu = "Collection";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Blood Collections <small>Recorded blood donations</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Collection</a>
    <a href="@Url.Action("Create", new { campId = 1 })" class="btn btn-outline-secondary"><i class="bi bi-truck"></i> Camp Collection</a>
  </div>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-check-circle-fill"></i><span>@s</span><button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-exclamation-triangle-fill"></i><span>@e</span><button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button></div> }

<div class="card">
  <div class="card-header"><h6>@Model.Collections.Count collections</h6></div>
  <div class="card-body p-0">
    <div class="table-container">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Bag #</th>
            <th>Donor ID</th>
            <th>Location</th>
            <th>Volume</th>
            <th>Camp</th>
            <th>Date/Time</th>
            <th>Notes</th>
            <th style="width:60px">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var c in Model.Collections)
          {
            <tr>
              <td><span class="badge badge-secondary">@c.BloodBagNumber</span></td>
              <td><a href="@Url.Action("Details","Donor",new{id=c.DonorId})" style="color:var(--bc-text)">#@c.DonorId</a></td>
              <td><span class="badge badge-info">@(c.CollectionLocationType ?? "—")</span></td>
              <td>@(c.BagVolumeMl?.ToString("F0") ?? "—") ml</td>
              <td style="font-size:11px">@(c.CampId.HasValue ? "Camp #" + c.CampId.ToString() : "—")</td>
              <td style="font-size:11px">@c.CollectionStartTime?.ToString("dd MMM yyyy HH:mm")</td>
              <td style="font-size:11px;max-width:200px;white-space:normal">@c.Notes</td>
              <td><a href="@Url.Action("Details",new{id=c.CollectionId})" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a></td>
            </tr>
          }
          @if (!Model.Collections.Any()) { <tr><td colspan="8"><div class="empty-state"><div class="empty-icon"><i class="bi bi-droplet"></i></div><div class="empty-title">No collections recorded</div><div class="empty-text">Start by recording a new blood collection.</div></div></td></tr> }
        </tbody>
      </table>
    </div>
  </div>
</div>
