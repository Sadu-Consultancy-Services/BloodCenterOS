@model List<EmergencyRequest>
@{
  ViewBag.Title = "Emergency Requests";
  ViewBag.ActiveMenu = "Emergency";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Emergency Requests <small>Urgent blood requests from hospitals</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-danger"><i class="bi bi-exclamation-triangle-fill"></i> New Emergency</a>
  </div>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-check-circle-fill"></i><span>@s</span></div> }

<div class="row g-2 mb-3">
  @foreach (var r in Model)
  {
    var isCritical = r.RequestStatus == "Critical";
    <div class="col-md-6">
      <div class="card @(isCritical ? "border-danger" : "")" style="@(isCritical ? "border-color:var(--bc-danger)!important;border-width:2px" : "")">
        <div class="card-body">
          <div class="d-flex align-items-start gap-3">
            <div class="stat-icon" style="background:@(isCritical ? "#fee2e2" : "#fef9c3");color:@(isCritical ? "#dc2626" : "#d97706");width:48px;height:48px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0">
              <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div style="flex:1">
              <div style="font-size:16px;font-weight:600">@r.PatientName</div>
              <div style="font-size:12px;color:var(--bc-text-muted);margin-top:2px">
                <span class="badge" style="background:#dcfce7;color:#166534">@r.BloodGroup</span>
                <span class="badge badge-info">@r.ComponentType</span>
                <span class="badge @(isCritical ? "badge-danger" : "badge-warning")">@r.RequestStatus</span>
              </div>
              <div class="d-flex gap-3 mt-2" style="font-size:12px;color:var(--bc-text-secondary)">
                <span><i class="bi bi-droplet"></i> @r.UnitsRequired units</span>
                <span><i class="bi bi-clock"></i> @r.RequestedAt.ToString("dd MMM HH:mm")</span>
                <span><i class="bi bi-building"></i> Hospital #@r.HospitalId</span>
              </div>
              @if (!string.IsNullOrEmpty(r.Notes))
              {
                <div style="font-size:11px;color:var(--bc-text-muted);margin-top:4px">@r.Notes</div>
              }
            </div>
            <div class="d-flex flex-column gap-1">
              <button class="btn btn-sm btn-primary"><i class="bi bi-send"></i> Issue</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  }
  @if (!Model.Any())
  {
    <div class="col-12">
      <div class="card"><div class="card-body">
        <div class="empty-state"><div class="empty-icon" style="color:var(--bc-success)"><i class="bi bi-check-circle-fill"></i></div><div class="empty-title">No emergency requests</div><div class="empty-text">All clear — no pending emergency requests.</div></div>
      </div></div>
    </div>
  }
</div>
