@model Designation
@{ ViewBag.Title = "Edit Designation"; ViewBag.ActiveMenu = "Designations"; }
<div class="page-header">
  <div><h1 class="page-title">Edit Designation <small>Update designation information</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post" action="@Url.Action("Edit", new { id = Model.DesignationId })">
  <div class="card mb-3">
    <div class="card-header"><h6>Designation Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Designation Name <span class="text-danger">*</span></label><input type="text" name="DesignationName" class="form-control" value="@Model.DesignationName" required /></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
  </div>
</form>
