@model CampInventory
@{ ViewBag.Title = "Edit Inventory Item"; ViewBag.ActiveMenu = "CampInventory"; }
<div class="page-header">
  <div><h1 class="page-title">Edit Inventory Item <small>Update item details</small></h1></div>
  <a href="@Url.Action("Index", new { campId = Model.CampId })" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post" action="@Url.Action("Edit", new { id = Model.CampInventoryId })">
  <div class="card mb-3">
    <div class="card-header"><h6>Item Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Item Name <span class="text-danger">*</span></label><input type="text" name="ItemName" class="form-control" value="@Model.ItemName" required /></div>
        <div class="col-md-6"><label class="form-label">Quantity</label><input type="number" name="Quantity" class="form-control" value="@Model.Quantity" /></div>
        <div class="col-md-6"><label class="form-label">Unit</label><input type="text" name="Unit" class="form-control" value="@Model.Unit" /></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index", new { campId = Model.CampId })" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
  </div>
</form>
