@model List<CrossMatchEntry>

@{
    ViewData["Title"] = "Start Cross Match";
    var pending = ViewBag.PendingReservations as List<CrossMatchEntry> ?? new();
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Start Cross Matching</h1>

    <div class="card mb-4">
        <div class="card-header">Pending Reservations for Cross Match</div>
        <div class="card-body">
            @if (pending.Any())
            {
                <table class="table table-bordered table-hover">
                    <thead><tr>
                        <th>Reservation #</th>
                        <th>Patient</th>
                        <th>Blood Group</th>
                        <th>Component</th>
                        <th>Units</th>
                        <th>Hospital</th>
                        <th>Date</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var item in pending)
                        {
                            <tr>
                                <td>@item.BloodRequestId</td>
                                <td>@item.PatientName</td>
                                <td>@item.RequiredBloodGroup</td>
                                <td>@item.ComponentType</td>
                                <td>@item.UnitsReserved</td>
                                <td>@item.HospitalName</td>
                                <td>@item.ReservationDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <form asp-action="Start" method="post" style="display:inline">
                                        <input type="hidden" name="bloodRequestId" value="@item.BloodRequestId" />
                                        <button type="submit" class="btn btn-primary btn-sm">Start CM</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No pending reservations requiring cross matching.</p>
            }
        </div>
    </div>
</div>
