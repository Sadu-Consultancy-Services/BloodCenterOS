@model List<Billing>
@{
  ViewBag.Title = "Billing";
  ViewBag.ActiveMenu = "Billing";
  var total = Model.Sum(b => b.TotalAmount ?? 0);
  var paid = Model.Where(b => b.PaymentStatus == "Paid").Sum(b => b.TotalAmount ?? 0);
  var outstanding = Model.Where(b => b.PaymentStatus != "Paid").Sum(b => b.TotalAmount ?? 0);
}

<div class="page-header">
  <div>
    <h1 class="page-title">Billing <small>Invoice &amp; payment management</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Invoice</a>
  </div>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-check-circle-fill"></i><span>@s</span></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3"><i class="bi bi-exclamation-triangle-fill"></i><span>@e</span></div> }

<div class="row g-2 mb-3">
  <div class="col-4"><div class="card stat-card"><div class="stat-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-currency-rupee"></i></div><div><div class="stat-value">₹@total.ToString("N0")</div><div class="stat-label">Total Invoiced</div></div></div></div>
  <div class="col-4"><div class="card stat-card"><div class="stat-icon" style="background:#dbeafe;color:#0284c7"><i class="bi bi-check-circle"></i></div><div><div class="stat-value">₹@paid.ToString("N0")</div><div class="stat-label">Collected</div></div></div></div>
  <div class="col-4"><div class="card stat-card"><div class="stat-icon" style="background:#fee2e2;color:#dc2626"><i class="bi bi-exclamation-triangle"></i></div><div><div class="stat-value">₹@outstanding.ToString("N0")</div><div class="stat-label">Outstanding</div></div></div></div>
</div>

<div class="card">
  <div class="card-header"><h6>@Model.Count invoices</h6></div>
  <div class="card-body p-0">
    <div class="table-container">
      <table class="table mb-0">
        <thead><tr><th>Invoice #</th><th>Patient ID</th><th>Amount</th><th>Tax</th><th>Discount</th><th>Net</th><th>Status</th><th>Mode</th><th>Date</th><th style="width:80px">Actions</th></tr></thead>
        <tbody>
          @foreach (var b in Model)
          {
            var net = (b.TotalAmount ?? 0) + (b.TaxAmount ?? 0) - (b.Discount ?? 0);
            <tr>
              <td><span class="badge badge-secondary">@b.InvoiceNumber</span></td>
              <td>#@b.PatientId</td>
              <td>₹@(b.TotalAmount?.ToString("N0"))</td>
              <td>₹@(b.TaxAmount?.ToString("N0"))</td>
              <td>₹@(b.Discount?.ToString("N0"))</td>
              <td class="fw-semibold">₹@net.ToString("N0")</td>
              <td><span class="badge @(b.PaymentStatus == "Paid" ? "badge-success" : b.PaymentStatus == "Partial" ? "badge-warning" : "badge-danger")">@b.PaymentStatus</span></td>
              <td style="font-size:11px">@(string.IsNullOrEmpty(b.PaymentMode) ? "—" : b.PaymentMode)</td>
              <td style="font-size:11px">@b.InvoiceDate.ToString("dd MMM yyyy")</td>
              <td>
                @if (b.PaymentStatus != "Paid")
                {
                  <a href="@Url.Action("Payment",new{id=b.BillingTransactionId})" class="btn btn-sm btn-primary">Pay</a>
                }
              </td>
            </tr>
          }
          @if (!Model.Any()) { <tr><td colspan="10"><div class="empty-state"><div class="empty-icon"><i class="bi bi-receipt"></i></div><div class="empty-title">No invoices</div></div></td></tr> }
        </tbody>
      </table>
    </div>
  </div>
</div>
