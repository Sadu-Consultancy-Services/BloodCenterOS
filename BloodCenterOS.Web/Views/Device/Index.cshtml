@model List<Device>
@{ ViewBag.Title = "Devices"; ViewBag.ActiveMenu = "Devices"; }
<div class="page-header">
  <div><h1 class="page-title">Devices <small>Manage equipment</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Device</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Name</th><th>Type</th><th>Serial No</th><th>Purchase Date</th><th>Warranty End</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">No devices found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.DeviceName</td><td>@item.DeviceType</td><td>@item.SerialNumber</td>
            <td>@item.PurchaseDate?.ToString("yyyy-MM-dd")</td><td>@item.WarrantyEndDate?.ToString("yyyy-MM-dd")</td>
            <td class="text-end">
              <a href="@Url.Action("Edit", new { id = item.DeviceId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form method="post" action="@Url.Action("Delete", new { id = item.DeviceId })" style="display:inline" onsubmit="return confirm('Delete this device?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
