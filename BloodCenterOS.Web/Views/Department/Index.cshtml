@model List<Department>
@{
  ViewBag.Title = "Departments";
  ViewBag.ActiveMenu = "Departments";
}
<div class="page-header">
  <div><h1 class="page-title">Departments <small>Manage departments</small></h1></div>
  <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Department</a>
</div>
@if (TempData["Success"] is string s) { <div class="alert alert-success py-2 px-3 mb-3">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger py-2 px-3 mb-3">@e</div> }
<div class="card">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead><tr><th>Code</th><th>Name</th><th>Description</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">No departments found.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td>@item.DepartmentCode</td><td>@item.DepartmentName</td><td>@item.Description</td>
            <td class="text-end">
              <a href="@Url.Action("Edit", new { id = item.DepartmentId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
              <form method="post" action="@Url.Action("Delete", new { id = item.DepartmentId })" style="display:inline" onsubmit="return confirm('Delete this department?')">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
