@model Department
@{ ViewBag.Title = "Add Department"; ViewBag.ActiveMenu = "Departments"; }
<div class="page-header">
  <div><h1 class="page-title">Add Department <small>Register a new department</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Department Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Department Code</label><input type="text" name="DepartmentCode" class="form-control" value="@Model.DepartmentCode" /></div>
        <div class="col-md-8"><label class="form-label">Department Name <span class="text-danger">*</span></label><input type="text" name="DepartmentName" class="form-control" value="@Model.DepartmentName" required /></div>
        <div class="col-12"><label class="form-label">Description</label><textarea name="Description" class="form-control" rows="2">@Model.Description</textarea></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
  </div>
</form>
