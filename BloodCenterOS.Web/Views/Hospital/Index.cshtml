@model List<Hospital>
@{
  ViewBag.Title = "Hospitals";
  ViewBag.ActiveMenu = "Hospitals";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Hospitals <small>Manage registered hospitals</small></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Hospital</a>
    <button class="btn btn-outline-secondary"><i class="bi bi-download"></i> Export</button>
  </div>
</div>

@if (TempData["Success"] is string success)
{
  <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3">
    <i class="bi bi-check-circle-fill"></i> <span>@success</span>
    <button type="button" class="btn-close ms-auto" style="font-size:10px" onclick="this.parentElement.remove()"></button>
  </div>
}

<div class="card">
  <div class="card-header">
    <h6>@Model.Count hospitals registered</h6>
    <div class="d-flex gap-2 align-items-center">
      <input type="text" class="form-control form-control-sm" placeholder="Search hospitals..." style="width:200px" />
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-container">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Hospital Name</th>
            <th>Address</th>
            <th>Contact Person</th>
            <th>Phone</th>
            <th>Email</th>
            <th style="width:60px">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var h in Model)
          {
            <tr>
              <td><span style="font-weight:500">@h.HospitalName</span></td>
              <td style="font-size:11px;max-width:250px;white-space:normal">@h.Address</td>
              <td>@h.ContactPerson</td>
              <td>@h.Phone</td>
              <td style="font-size:11px">@h.Email</td>
              <td>
                <div class="d-flex gap-1">
                  <button class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></button>
                  <button class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></button>
                </div>
              </td>
            </tr>
          }
          @if (!Model.Any())
          {
            <tr>
              <td colspan="6">
                <div class="empty-state">
                  <div class="empty-icon"><i class="bi bi-building"></i></div>
                  <div class="empty-title">No hospitals registered</div>
                  <div class="empty-text">Add a hospital to get started with blood requests and issues.</div>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
