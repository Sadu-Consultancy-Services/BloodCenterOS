@model Hospital
@{ ViewBag.Title = "Edit Hospital"; ViewBag.ActiveMenu = "Hospitals"; }
<div class="page-header">
  <div><h1 class="page-title">Edit Hospital <small>@Model.HospitalName</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>
@if (!ViewData.ModelState.IsValid)
{
  <div class="alert alert-danger d-flex flex-column gap-1 mb-3 py-2 px-3">
    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
      <div class="d-flex align-items-center gap-2"><i class="bi bi-exclamation-circle"></i> <span>@err.ErrorMessage</span></div>
    }
  </div>
}
<form method="post" action="@Url.Action("Edit", new { id = Model.HospitalId })">
  <div class="card mb-3">
    <div class="card-header"><h6>Hospital Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-8">
          <label class="form-label">Hospital Name <span class="text-danger">*</span></label>
          <input type="text" name="HospitalName" class="form-control" value="@Model.HospitalName" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Hospital Code</label>
          <input type="text" name="HospitalCode" class="form-control" value="@Model.HospitalCode" />
        </div>
        <div class="col-12">
          <label class="form-label">Address</label>
          <textarea name="Address" class="form-control" rows="2">@Model.Address</textarea>
        </div>
      </div>
    </div>
  </div>
  <div class="card mb-3">
    <div class="card-header"><h6>Contact Information</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4">
          <label class="form-label">Contact Person</label>
          <input type="text" name="ContactPerson" class="form-control" value="@Model.ContactPerson" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Phone</label>
          <input type="tel" name="Phone" class="form-control" value="@Model.Phone" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Email</label>
          <input type="email" name="Email" class="form-control" value="@Model.Email" />
        </div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
  </div>
</form>
