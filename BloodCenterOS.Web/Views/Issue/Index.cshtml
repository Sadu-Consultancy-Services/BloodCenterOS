@model List<IssueRecord>

@{
    ViewData["Title"] = "Blood Issues";
    var ready = ViewBag.ReadyForIssue as List<ReservationReadyForIssue> ?? new();
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Blood Issuing</h1>

    @if (TempData["Success"] is string s) { <div class="alert alert-success">@s</div> }
    @if (TempData["Error"] is string e) { <div class="alert alert-danger">@e</div> }

    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-check-circle me-1"></i> Ready for Issue (Cross-matched &amp; Passed)</div>
        <div class="card-body">
            @if (ready.Any())
            {
                <table class="table table-bordered table-hover">
                    <thead><tr>
                        <th>Reservation #</th>
                        <th>Patient</th>
                        <th>Blood Group</th>
                        <th>Component</th>
                        <th>Units</th>
                        <th>Hospital</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in ready)
                        {
                            <tr>
                                <td>@r.ReservationId</td>
                                <td>@r.PatientName</td>
                                <td>@r.RequiredBloodGroup</td>
                                <td>@r.ComponentType</td>
                                <td>@r.UnitsReserved</td>
                                <td>@r.HospitalName</td>
                                <td><a asp-action="Create" asp-route-reservationId="@r.ReservationId" class="btn btn-success btn-sm">Issue</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No reservations ready for issue. Complete cross-matching first.</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-history me-1"></i> Issue History</div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead><tr>
                    <th>#</th>
                    <th>Patient</th>
                    <th>Component</th>
                    <th>Type</th>
                    <th>Blood Group</th>
                    <th>Issue Date</th>
                    <th></th>
                </tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IssueRecordId</td>
                            <td>@item.PatientName</td>
                            <td>@item.ComponentCode</td>
                            <td>@item.ComponentType</td>
                            <td>@item.BloodGroup</td>
                            <td>@item.IssueDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a asp-action="Details" asp-route-reservationId="@item.RelatedBillingId" class="btn btn-sm btn-info">View</a></td>
                        </tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="7" class="text-center">No issue history</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
