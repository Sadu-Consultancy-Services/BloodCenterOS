@{
    ViewData["Title"] = "Issue Blood";
    var ready = ViewBag.ReadyForIssue as List<ReservationReadyForIssue> ?? new();
    var selected = ViewBag.Selected as ReservationReadyForIssue;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Issue Blood to Patient</h1>

    @if (selected != null)
    {
        <div class="card mb-4">
            <div class="card-header">Reservation Summary</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Patient:</strong> @selected.PatientName</div>
                    <div class="col-md-2"><strong>Blood Group:</strong> @selected.RequiredBloodGroup</div>
                    <div class="col-md-2"><strong>Component:</strong> @selected.ComponentType</div>
                    <div class="col-md-1"><strong>Units:</strong> @selected.UnitsReserved</div>
                    <div class="col-md-2"><strong>Hospital:</strong> @selected.HospitalName</div>
                    <div class="col-md-2"><strong>CM #:</strong> @selected.CrossMatchEntryId</div>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" name="reservationId" value="@selected.ReservationId" />

            <div class="card mb-4">
                <div class="card-header">Issue Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Payment Mode</label>
                            <select name="paymentMode" class="form-select">
                                <option value="">No Invoice (Free/Donation)</option>
                                <option value="Cash" selected>Cash</option>
                                <option value="Credit">Credit</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Notes</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Optional notes"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Confirm Issue</button>
            </div>
        </form>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header">Select a Reservation</div>
            <div class="card-body">
                @if (ready.Any())
                {
                    <table class="table table-bordered">
                        <thead><tr>
                            <th>Reservation #</th>
                            <th>Patient</th>
                            <th>Blood Group</th>
                            <th>Component</th>
                            <th>Units</th>
                            <th></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in ready)
                            {
                                <tr>
                                    <td>@r.ReservationId</td>
                                    <td>@r.PatientName</td>
                                    <td>@r.RequiredBloodGroup</td>
                                    <td>@r.ComponentType</td>
                                    <td>@r.UnitsReserved</td>
                                    <td><a asp-action="Create" asp-route-reservationId="@r.ReservationId" class="btn btn-primary btn-sm">Select</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No completed cross-matches ready for issue.</p>
                }
            </div>
        </div>
    }
</div>
