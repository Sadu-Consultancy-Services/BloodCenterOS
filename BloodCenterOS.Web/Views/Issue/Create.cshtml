@model IssueRecord
@{
  ViewBag.Title = "New Blood Issue";
  ViewBag.ActiveMenu = "Issue";
}

<div class="page-header">
  <div>
    <h1 class="page-title">New Blood Issue <small>Cross-match &amp; issue to patient</small></h1>
  </div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger d-flex flex-column gap-1 mb-3 py-2 px-3">@foreach(var err in ViewData.ModelState.Values.SelectMany(v=>v.Errors)){<div class="d-flex align-items-center gap-2"><i class="bi bi-exclamation-circle"></i><span>@err.ErrorMessage</span></div>}</div> }

<form method="post" action="@Url.Action("Create")">
  <div class="card mb-3">
    <div class="card-header"><h6>Issue Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label">Patient Name <span class="text-danger">*</span></label>
          <input type="text" name="PatientName" class="form-control" value="@Model.PatientName" required />
        </div>
        <div class="col-md-3">
          <label class="form-label">Issue Type</label>
          <select name="IssueType" class="form-select">
            <option value="Cross-match" selected="@(Model.IssueType == "Cross-match")">Cross-match</option>
            <option value="Emergency" selected="@(Model.IssueType == "Emergency")">Emergency</option>
            <option value="Regular" selected="@(Model.IssueType == "Regular")">Regular</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Issue Slip #</label>
          <input type="text" name="IssueSlipNumber" class="form-control" value="@Model.IssueSlipNumber" placeholder="Auto" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Component ID</label>
          <input type="number" name="ComponentId" class="form-control" value="@Model.ComponentId" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Bag ID</label>
          <input type="number" name="BagId" class="form-control" value="@Model.BagId" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Hospital ID</label>
          <input type="number" name="HospitalId" class="form-control" value="@Model.HospitalId" />
        </div>
        <div class="col-12">
          <label class="form-label">Notes</label>
          <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Issue</button>
  </div>
</form>
