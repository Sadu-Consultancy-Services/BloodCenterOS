@model DeferralRecord
@{ ViewBag.Title = "New Deferral"; ViewBag.ActiveMenu = "Deferrals"; }
<div class="page-header">
  <div><h1 class="page-title">New Deferral <small>Record a donor deferral</small></h1></div>
  <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<form method="post">
  <div class="card mb-3">
    <div class="card-header"><h6>Deferral Details</h6></div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4"><label class="form-label">Donor ID <span class="text-danger">*</span></label><input type="number" name="DonorId" class="form-control" value="@Model.DonorId" required /></div>
        <div class="col-md-8"><label class="form-label">Reason <span class="text-danger">*</span></label><input type="text" name="Reason" class="form-control" value="@Model.Reason" required /></div>
        <div class="col-md-4"><label class="form-label">Deferral Date</label><input type="date" name="DeferralDate" class="form-control" value="@Model.DeferralDate.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-4"><label class="form-label">Until</label><input type="date" name="DeferralUntil" class="form-control" value="@Model.DeferralUntil?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-12"><label class="form-label">Notes</label><textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea></div>
      </div>
    </div>
  </div>
  <div class="d-flex gap-2 justify-content-end">
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
  </div>
</form>
